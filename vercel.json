{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "60mb",
        "includeFiles": [
          "app.py",
          "models/**",
          "services/**",
          "storage/**",
          "analytics/**",
          "templates/**",
          "static/**",
          "migrations/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
