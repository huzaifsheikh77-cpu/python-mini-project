# ============================================================================
# Employee Payroll Management System - environment template
# Copy this file to .env and fill in your own values. Never commit .env.
# ============================================================================

# Storage backend: "database" for Supabase PostgreSQL, "csv" for local files.
# When this line is removed, the app uses PostgreSQL if DATABASE_URL is set
# and falls back to CSV otherwise.
PAYROLL_STORAGE=database

# Supabase -> Project Settings -> Database -> Connection string -> URI
#
# For Vercel / any serverless host use the TRANSACTION POOLER (port 6543).
# For a persistent server or a local script, the direct connection (port 5432)
# is also fine. Keep sslmode=require.
#
# Replace <project-ref>, <region> and <password> with your own values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: a separate database used by the database test suite.
# Never point this at production - the tests truncate their tables.
# PAYROLL_TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/payroll_test?sslmode=disable

# Optional: signs the Flask session cookie used for flash messages.
# A development default exists, so this is only needed to override it.
PAYROLL_SECRET_KEY=replace-with-a-long-random-string

# Local development only: debugger + auto-reload. Set to 0 for a plain local run.
# Vercel serves the app as a WSGI callable and never calls app.run(), so production
# debug mode is always off there.
PAYROLL_DEBUG=1
